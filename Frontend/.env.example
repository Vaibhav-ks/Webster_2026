# Frontend (Vite) settings. Copy to .env.local for development.
# Only VITE_* values reach the browser; never put secrets here.

# Where the browser calls the API. Keep "/api" so requests stay same-origin
# (Vite dev proxy locally, the Cloudflare Pages Function in production).
VITE_API_BASE_URL=/api

# Google Identity Services OAuth client ID (public). Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Largest video that can be saved to an account, in MB (the API enforces its own limit too).
VITE_MAX_UPLOAD_MB=2048

# Dev only: where the Vite proxy forwards /api (read from the shell environment).
# API_DEV_TARGET=http://localhost:4000
