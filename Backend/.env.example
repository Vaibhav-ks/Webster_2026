# Scarlet Rewrite API. Copy to .env for local development (never commit .env).
# Placeholders only: generate your own secrets.

NODE_ENV=development
PORT=4000

# PostgreSQL. Local: `docker compose up -d db` from the repo root.
# Neon: paste its connection string (keep ?sslmode=require).
DATABASE_URL=postgres://scarlet:scarlet@localhost:5432/scarlet
# Only for `npm test`: a database where the user may CREATE/DROP DATABASE.
TEST_DATABASE_URL=postgres://scarlet:scarlet@localhost:5432/postgres

# Access-token signing key, at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=30

# Exact origin(s) of the frontend, comma-separated. Used to protect the cookie
# endpoints (refresh / logout) against CSRF.
APP_ORIGINS=http://localhost:5173
# Secure cookies need HTTPS; defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Proxy hops in front of Express (Render = 1). Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1
# Shared with the Cloudflare Pages Function so the real client IP can be trusted.
PROXY_SHARED_SECRET=

# Google Identity Services OAuth client ID (same value as the frontend's VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- video storage
# Where original videos are kept: s3 | cloudinary | none.
# (Unset: s3 if S3_BUCKET/R2_BUCKET is set, cloudinary if CLOUDINARY_* is set, else none.)
STORAGE_DRIVER=

# --- S3-compatible: Cloudflare R2, AWS S3, Backblaze B2, Wasabi, DigitalOcean Spaces, MinIO ...
# Private bucket; keys need read/write on this bucket only.
#   R2:        S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com   S3_REGION=auto
#   AWS S3:    leave S3_ENDPOINT empty                                   S3_REGION=ap-south-1
#   Backblaze: S3_ENDPOINT=https://s3.<region>.backblazeb2.com            S3_REGION=<region>
#   MinIO:     S3_ENDPOINT=http://localhost:9000                         S3_REGION=us-east-1
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: S3_FORCE_PATH_STYLE=true|false (default: true with an endpoint, false for AWS)
# Optional: S3_MAX_UPLOAD_BYTES=...
# The older R2_ACCOUNT_ID / R2_BUCKET / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY still work.

# --- Cloudinary (STORAGE_DRIVER=cloudinary)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#   or CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET
CLOUDINARY_URL=
# private (default) or authenticated. Public "upload" delivery is refused.
CLOUDINARY_DELIVERY_TYPE=private
# Your plan's maximum video size (free plan: 100 MB).
CLOUDINARY_MAX_UPLOAD_BYTES=100000000
CLOUDINARY_CHUNK_SIZE=20971520

# Uploads
MAX_UPLOAD_BYTES=2147483648
UPLOAD_PART_SIZE=16777216
UPLOAD_URL_TTL_S=900
DOWNLOAD_URL_TTL_S=600
PENDING_UPLOAD_TTL_HOURS=24
CLEANUP_INTERVAL_MIN=15
